---
// 首页"唠嗑版"排名列表——区别于 RankingEntries.astro（/rankings/ 系列页面用，
// 带评分/调整明细的正式列表）和机场荟 CompareSnippet.astro（表格形式），
// 这里只保留"第几名 + 名字 + 为什么选它"三件事，语气更像聊天时随口一句
// 推荐理由，不是正式对比表格或评分面板。
import type { RankingComputation } from '../data/utils/ranking-scoring';

interface Props {
  entries: RankingComputation[];
}

const { entries } = Astro.props;
---

<ol class="talk-ranking">
  {
    entries.map((entry) => (
      <li class={`talk-ranking__item${entry.finalRank === 1 ? ' talk-ranking__item--top' : ''}`}>
        <span class="talk-ranking__rank">
          {entry.finalRank === 1 ? '👑' : entry.finalRank}
        </span>
        <div class="talk-ranking__body">
          <div class="talk-ranking__header-row">
            <a
              class="talk-ranking__name"
              href={`/airports/${entry.providerSlug}/`}
              data-analytics-event="recommendation_card_click"
              data-provider={entry.providerSlug}
              data-provider-name={entry.providerName}
              data-cta-label={`首页唠嗑榜第${entry.finalRank}名`}
            >
              {entry.providerName}
            </a>
            {entry.finalRank === 1 && (
              <span class="talk-ranking__badge-gold">👑 编辑部力荐 · 综合第 1 名</span>
              <span class="talk-ranking__price-pill">低至 ¥6.6/月（MINI档）</span>
            )}
          </div>
          <p class="talk-ranking__reason">
            <span class="talk-ranking__reason-label">为什么选它：</span>
            {entry.reason}
          </p>
        </div>
        {entry.finalRank === 1 && (
          <a
            class="talk-ranking__cta-btn"
            href={`/airports/${entry.providerSlug}/`}
            data-analytics-event="recommendation_card_click"
            data-provider={entry.providerSlug}
            data-provider-name={entry.providerName}
            data-cta-label="首页唠嗑榜第1名直达"
          >
            查看评测 →
          </a>
        )}
      </li>
    ))
  }
</ol>

<style>
  .talk-ranking {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .talk-ranking__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .talk-ranking__item--top {
    border: 2px solid #f59e0b;
    background: linear-gradient(165deg, rgba(245, 158, 11, 0.1), var(--color-surface) 65%);
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.18);
  }

  .talk-ranking__rank {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-surface-soft);
    color: var(--color-muted);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .talk-ranking__item--top .talk-ranking__rank {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    font-size: 1.125rem;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
  }

  .talk-ranking__body {
    min-width: 0;
    flex: 1 1 auto;
  }

  .talk-ranking__header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .talk-ranking__badge-gold {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
  }

  .talk-ranking__price-pill {
    background: rgba(245, 158, 11, 0.12);
    color: #d97706;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  :root[data-theme='dark'] .talk-ranking__price-pill {
    background: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
    border-color: rgba(245, 158, 11, 0.4);
  }

  .talk-ranking__cta-btn {
    align-self: center;
    flex-shrink: 0;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
    white-space: nowrap;
    transition: transform 0.15s ease;
  }

  .talk-ranking__cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.5);
  }

  .talk-ranking__name {
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .talk-ranking__name:hover {
    color: var(--color-primary);
  }

  .talk-ranking__reason {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .talk-ranking__reason-label {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
